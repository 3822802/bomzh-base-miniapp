# Скопируй в .env.local и заполни. НЕ коммитить .env.local (он в .gitignore).
# ВАЖНО: сюда НЕ вставлять приватный ключ/сид кошелька владельца.
# Подпись транзакций — только в кошельке.

# ── Единственный ключ во всём проекте ──
# Ключ Anthropic для ИИ-агента Бомж (модель Haiku 4.5 — самая дешёвая).
# Берётся на console.anthropic.com. Это ОТДЕЛЬНО от подписки Claude:
# задеплоенное приложение по подписке ходить не может, ему нужен API-ключ.
ANTHROPIC_API_KEY=

# Больше ничего не нужно:
# • CDP-ключ не нужен — серверная сторона x402 убрана, агент платит как ПОКУПАТЕЛЬ
# • ключ подписанта не нужен — рулетка детерминированная, без ваучеров
# • ключ OnchainKit не нужен — OnchainKit убран
