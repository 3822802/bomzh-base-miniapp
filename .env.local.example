# Скопируй в .env.local и заполни. НЕ коммитить .env.local (он в .gitignore).
# ВАЖНО: сюда НЕ вставлять приватный ключ/сид кошелька владельца. Подпись — только в кошельке.

# ── Клиент (публичное) ──
# OnchainKit / Coinbase Developer Platform — публичный клиентский ключ
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# ── Сервер (секреты, БЕЗ префикса NEXT_PUBLIC_) ──
# CDP API-ключ для x402-фасилитатора (mainnet). Берётся на portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Серверный ключ ТОЛЬКО для подписи ваучеров рулетки (EIP-712).
# ⚠️ НЕ кошелёк владельца! Отдельный одноразовый ключ (напр. `cast wallet new`).
# Утечка = максимум лишний минт NFT, ротируется через setServerSigner в контракте.
SPIN_SIGNER_PRIVATE_KEY=

# Ключ модели для ИИ-агента Бомж (AgentKit) — добавится, когда подключим агента.
MODEL_API_KEY=
